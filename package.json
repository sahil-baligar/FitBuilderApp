{
  "name": "fitbuilder",
  "private": true,
  "version": "0.2.0",
  "description": "FitBuilder monorepo: shared core, Expo mobile app, Vite web app, and API server.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:mobile": "npm run start -w apps/mobile",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:mobile:web": "npm run build:web -w apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}

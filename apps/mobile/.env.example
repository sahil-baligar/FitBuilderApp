# FitBuilder mobile (Expo) — copy to .env and adjust.
# All values must be prefixed EXPO_PUBLIC_ to be inlined into the bundle.

# Origin of the FitBuilder API (the `/api` base path is appended automatically).
#
# Leave BOTH of these blank for local development: the app then derives the API
# host from the Expo dev server it was loaded from, so Expo Go on a phone hits
# your machine's LAN address automatically and nothing needs editing when your
# IP changes. Set one explicitly only to point at a deployed API.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8788
# EXPO_PUBLIC_API_BASE_URL=https://fitbuilder-api.up.railway.app

# Port the local dev API listens on. Must match PORT in apps/api/.env.
EXPO_PUBLIC_API_PORT=8788

# Optional: Supabase project for cloud sync + auth. Leave blank to run local-only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# FitBuilder API - copy to apps/api/.env (never commit real keys)

# --- Server -----------------------------------------------------------------
# Port to listen on (Railway injects PORT automatically).
PORT=8787
# Comma-separated list of allowed browser origins. "*" allows any origin.
# On Railway set this to your web service URL, e.g. https://fitbuilder-web.up.railway.app
CORS_ORIGINS=*
# Where job records (JSON) and downloaded local models are stored.
DATA_DIR=./data
# How many image jobs run at the same time.
JOB_CONCURRENCY=2
# Hours before finished jobs (and their large data-URL results) are evicted.
JOB_TTL_HOURS=24

# --- Railway Postgres -------------------------------------------------------
# Linked automatically when you add a Postgres plugin on Railway.
# Locally: postgresql://postgres:postgres@localhost:5432/fitbuilder
# Apply schema once: psql "$DATABASE_URL" -f db/schema.sql
DATABASE_URL=

# --- fal.ai (ghost render, try-on, style frames, cloud cutout) --------------
# Without FAL_KEY: cutout falls back to the local BiRefNet model, and ghost /
# try-on / style frames run against the deterministic "mock" provider.
# On Railway (no GPU): set FAL_KEY — local BiRefNet / Ollama are for dev only.
FAL_KEY=
# Optional overrides of the verified endpoint ids in src/config/models.ts.
FAL_MODEL_EDIT=
FAL_MODEL_TRYON=
FAL_MODEL_CUTOUT=

# --- ChatGPT / OpenAI (primary AI for stylist + garment analysis) -----------
# Required for production on Railway. Without it, analysis/stylist fall back
# to Ollama (local) or mock (PROVIDERS=mock).
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# --- OpenWeatherMap (GET /api/weather) --------------------------------------
WEATHER_API_KEY=

# --- Ollama (optional local-dev fallback) -----------------------------------
# Only used when preferLocal=true on a garment job, or ANALYSIS_PROVIDER=ollama,
# or OPENAI_API_KEY is unset.
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_MS=240000

# --- Local cutout (transformers.js) -----------------------------------------
# MIT-licensed BiRefNet ONNX export; downloaded on first use into DATA_DIR/models.
# Used when CUTOUT_PROVIDER=local|auto and FAL_KEY is unset (dev machines).
LOCAL_CUTOUT_MODEL=onnx-community/BiRefNet_lite

# --- Provider overrides (mostly for tests / debugging) ----------------------
# Force every capability to the offline mock provider: PROVIDERS=mock
PROVIDERS=
# Per-capability overrides: auto | fal | local | mock   (cutout)
#                           auto | ollama | openai | mock (analysis)
#                           auto | fal | mock           (ghost, tryon, styleframe)
CUTOUT_PROVIDER=auto
ANALYSIS_PROVIDER=auto
GHOST_PROVIDER=auto
TRYON_PROVIDER=auto
STYLEFRAME_PROVIDER=auto

# ---------------------------------------------------------------------------
# Authentication (Supabase)
# ---------------------------------------------------------------------------
# Setting SUPABASE_URL turns on local JWT verification against the project's
# JWKS. Required in production: the server refuses to start without it.
SUPABASE_URL=
# Only needed when Supabase sits behind a custom domain.
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Escape hatch for local work with no Supabase project. Rejected in production.
# AUTH_REQUIRED=false

# ---------------------------------------------------------------------------
# Free-tier quotas, per account per calendar month
# ---------------------------------------------------------------------------
# Every one of these actions bills a provider per call, so the ceiling is
# enforced server-side. The client also hides gated actions, but that is
# presentation only.
FREE_GARMENTS_PER_MONTH=15
FREE_TRYONS_PER_MONTH=3
FREE_STYLEFRAMES_PER_MONTH=3
# AI stylist is the paid feature; 0 means Pro-only.
FREE_STYLIST_PER_MONTH=0
# Fair-use ceiling applied to Pro accounts.
PRO_CEILING_PER_MONTH=500
